	(model "${KIPRJMOD}/lib/RPI-CM5-IO/CM5IO.3dshapes/CM5liteR5-3dstep.step"
		(hide yes)
		(offset
			(xyz 0 0 0)
		)
		(scale
			(xyz 1 1 1)
		)
		(rotate
			(xyz 0 0 0)
		)
	)
	(model "${KIPRJMOD}/lib/RPI-CM5-IO/CM5IO.3dshapes/CM5R5-3dsteps.step"
		(offset
			(xyz 36 -3.5 1.6)
		)
		(scale
			(xyz 1 1 1)
		)
		(rotate
			(xyz -0 -0 -90)
		)
	)
)
