	(text "DESIGN NOTE:\nVREF = 2.495V\nVTH = 2.495V × (10k / (43.2k + 10k))\nVTH ≈ 0.469V\n\nRtop = R808 + R811 = 100k + 1.65M = 1.75M\nRbottom = R817 = 100k\nRfeedback = R820 = 10M\nRpullup = R814 = 47k\n\nPassive divider ratio, without output feedback:\nACC_DIV = ACC_IN × (100k / (1.75M + 100k))\nACC_DIV = ACC_IN × 0.05405\n\nWith OUT LOW, R820 is effectively a weak extra pull-down:\nACC rising threshold ≈ 8.76V\n\nWith OUT HIGH, R820 feeds a small amount of +3V3_AON back\nto ACC_DIV:\nACC falling threshold ≈ 8.18V\n\nHysteresis ≈ 0.58V\n\nACC = 0V      -> ACC_DIV = 0V      -> ACC_OK low\nACC = 8.18V   -> ACC_OK can remain high\nACC = 8.76V   -> ACC_OK changes high\nACC = 12V     -> ACC_DIV ≈ 0.673V -> ACC_OK high\nACC = 14.4V   -> ACC_DIV ≈ 0.802V -> ACC_OK high\nACC = 30.7V   -> ACC_DIV ≈ 1.675V -> ACC_OK high\nACC = 35V     -> ACC_DIV ≈ 1.905V -> ACC_OK high\n\nInput filter:\nRTH ≈ 94k\nC = 100nF\nτ ≈ 9.4ms\n\nOutput pull-up current when ACC_OK is low:\n3.3V / 47k ≈ 70µA per channel\nThree low outputs ≈ 211µA"
		(exclude_from_sim no)
		(at 13.97 224.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "05e477c0-e68d-41c8-abe0-92435e862e65")
	)
