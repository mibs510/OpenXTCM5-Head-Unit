	(text "DESIGN NOTE:\nFor USB firmware update from the CM5,\nyou’ll want two CM5-controlled signals:\nRP2354_RUN_CONTROL\nRP2354_USB_BOOT / QSPI_SS_CONTROL\n\nSequence:\n1. Pull QSPI_SS/USB_BOOT low\n2. Pull RUN low\n3. Release RUN high\n4. Release QSPI_SS after reset sampling window\n5. RP2354 enumerates to CM5 as USB boot device"
		(exclude_from_sim no)
		(at 26.67 85.09 0)
		(effects
